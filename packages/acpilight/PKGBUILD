# Maintainer: Angga Permana <anggape.dev@gmail.com>

pkgname=acpilight
pkgver=1.2
pkgrel=3
pkgdesc="backward-compatibile xbacklight replacement"
arch=("any")
url="https://gitlab.com/wavexx/acpilight"
license=(
  "GPL-3.0-only"
)
depends=(
  "python"
)
source=(
  "$url/-/archive/v$pkgver/$pkgname-v$pkgver.tar.bz2"
)
sha256sums=(
  "0b80cbe7edaf48307fc26dbb34c260ec9ed0c19c56743291e5a7cc23044ff9ae"
)
provides=(
  "xorg-xbacklight"
)
conflicts=(
  "xorg-xbacklight"
)

package() {
  cd "$pkgname-v$pkgver"
  install -vDm0755 xbacklight "$pkgdir/usr/bin/xbacklight"
  install -vDm0644 xbacklight.1 "$pkgdir/usr/share/man/man1/xbacklight.1"
  install -vDm0644 90-backlight.rules "$pkgdir/usr/lib/udev/rules.d/90-backlight.rules"
  install -vDm0644 README.rst NEWS.rst -t "$pkgdir/usr/share/doc/$pkgname"
}
