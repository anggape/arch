# Maintainer: Angga Permana <anggape.dev@gmail.com>

_realpkgname="alacritty"
pkgname="alacritty-sixel"
pkgdesc="A cross-platform, GPU-accelerated terminal emulator (Sixel Fork)"
pkgver=0.16.1
pkgrel=1
arch=("x86_64")
url="https://github.com/ayosec/alacritty"
license=(
  "Apache-2.0"
  "MIT"
)
makedepends=(
  "rust"
  "cargo"
  "cmake"
  "ncurses"
  "desktop-file-utils"
  "gdb"
  "libxcb"
  "scdoc"
)
depends=(
  "freetype2"
  "fontconfig"
  "libxi"
  "libxcursor"
  "libxkbcommon"
  "libxkbcommon-x11"
  "libxrandr"
)
checkdepends=(
  "ttf-dejavu"
)
optdepends=(
  "ncurses: for alacritty terminfo database"
)
source=(
  "$url/archive/refs/tags/v$pkgver-graphics.tar.gz"
)
sha256sums=(
  "2b0b88ea868daf9282a8a77d7dd5cd2f787f3227cd4281bd6a171d811057e096"
)
provides=(
  $_realpkgname
)
conflicts=(
  $_realpkgname
)

prepare() {
  cd "$_realpkgname-$pkgver-graphics"
  cargo fetch --locked --target "$(rustc -vV | sed -n "s/host: //p")"
}

build(){
  cd "$_realpkgname-$pkgver-graphics"
  CARGO_INCREMENTAL=0 cargo build --release --locked --offline
}

check(){
  cd "$_realpkgname-$pkgver-graphics"
  CARGO_INCREMENTAL=0 cargo test --locked --offline
}

package() {
  cd "$_realpkgname-$pkgver-graphics"
  desktop-file-install -m 644 --dir   \
    "$pkgdir/usr/share/applications/" \
    "extra/linux/Alacritty.desktop"
  install -D -m755 "target/release/alacritty" "$pkgdir/usr/bin/alacritty"
  scdoc < "extra/man/alacritty.1.scd" |
    install -D -m644 /dev/stdin "$pkgdir/usr/share/man/man1/alacritty.1"
  scdoc < "extra/man/alacritty.5.scd" |
    install -D -m644 /dev/stdin "$pkgdir/usr/share/man/man5/alacritty.5"
  scdoc < "extra/man/alacritty-msg.1.scd" |
    install -D -m644 /dev/stdin "$pkgdir/usr/share/man/man1/alacritty-msg.1"
  scdoc < "extra/man/alacritty-bindings.5.scd" |
    install -D -m644 /dev/stdin "$pkgdir/usr/share/man/man5/alacritty-bindings.5"
  install -D -m644 "extra/linux/org.alacritty.Alacritty.appdata.xml" \
    "$pkgdir/usr/share/metainfo/org.alacritty.Alacritty.appdata.xml"
  install -D -m644 "extra/completions/alacritty.bash" \
    "$pkgdir/usr/share/bash-completion/completions/alacritty"
  install -D -m644 "extra/completions/_alacritty" \
    "$pkgdir/usr/share/zsh/site-functions/_alacritty"
  install -D -m644 "extra/completions/alacritty.fish" \
    "$pkgdir/usr/share/fish/vendor_completions.d/alacritty.fish"
  install -D -m644 "extra/logo/compat/alacritty-term.svg" \
    "$pkgdir/usr/share/pixmaps/Alacritty.svg"
}
